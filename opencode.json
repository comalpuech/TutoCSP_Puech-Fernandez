{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-8b-32k",
  "small_model": "ollama/qwen3-8b-32k",
  "tools": {
    "webfetch": false
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-8b-32k": { "name": "Qwen3 8B - contexte 32k" },
        "qwen3-coder-30b-32k": { "name": "Qwen3-Coder 30B-A3B - contexte 32k" },
        "gpt-oss-20b-32k": { "name": "gpt-oss 20B - contexte 32k" }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen/qwen3-8b": { "name": "Qwen3 8B (LM Studio)" }
      }
    }
  }
